# Recorded HTTP fixtures are gzip-compressed JSON (see cassette.py) -- a
# textual three-way merge of gzip bytes produces garbage rather than a
# conflict, so refuse to merge or diff them: resolve by re-recording
# instead.
#
#   RECORD=<slug> poetry run pytest tests/scraper_test.py -k <slug>
tests/test-cases/*-replay_data.json.gz -merge -diff -text linguist-generated linguist-vendored

# Expected results are small and human-readable, so keep them diffable — but
# still never auto-merged, since two branches editing the same council's
# fixture means one of them recorded against a different site state.
tests/test-cases/*-result.json -merge linguist-generated

# Regenerated on main by .github/workflows/status.yml. Never hand-edited, so
# a conflict here means two branches raced — resolve by regenerating.
docs/status.md -merge linguist-generated
